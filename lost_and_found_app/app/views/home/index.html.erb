<h1>Lost & Found</h1>

<p>Find and claim items reported at your facility.</p>

<% if user_signed_in? %>
  <%= link_to "Browse items", items_path %>
<% else %>
  <p>Sign in to browse the lost-and-found items.</p>
  <%= link_to "Sign in", new_user_session_path %>
  <%= link_to "Create an account", new_user_registration_path %>
<% end %>
