<h1>Items</h1>

<%= form_with url: items_path, method: :get do |form| %>
  <div>
    <%= form.label :query, "Search title or description" %>
    <%= form.search_field :query, value: params[:query] %>
  </div>

  <div>
    <%= form.label :category %>
    <%= form.select :category,
                    Item.categories.keys.map { |category| [category.humanize, category] },
                    { include_blank: "All categories", selected: params[:category] } %>
  </div>

  <div>
    <%= form.label :sort, "Date found" %>
    <%= form.select :sort,
                    [["Newest first", "newest"], ["Oldest first", "oldest"]],
                    { selected: @sort } %>
  </div>

  <div>
    <%= form.label :date_from, "Found from" %>
    <%= form.date_field :date_from, value: params[:date_from] %>
  </div>

  <div>
    <%= form.label :date_to, "Found to" %>
    <%= form.date_field :date_to, value: params[:date_to] %>
  </div>

  <% if current_user.staff? %>
    <div>
      <%= form.label :status %>
      <%= form.select :status,
                      Item.statuses.keys.map { |status| [status.humanize, status] },
                      { include_blank: "All statuses", selected: params[:status] } %>
    </div>
  <% else %>
    <div>
      <%= form.label :facility_id, "Facility" %>
      <%= form.collection_select :facility_id, Facility.order(:name), :id, :name,
                                 { include_blank: "All facilities", selected: params[:facility_id] } %>
    </div>
  <% end %>

  <%= form.submit "Search" %>
  <%= link_to "Clear filters", items_path %>
<% end %>

<% if @date_filter_error.present? %>
  <p class="alert"><%= @date_filter_error %></p>
<% end %>

<div id="items">
  <% @items.each do |item| %>
    <%= render item %>
    <p>
      <%= link_to "Show this item", item %>
    </p>
  <% end %>
</div>

<% if @items.empty? %>
  <p>No items match your filters.</p>
<% end %>

<% if @total_pages > 1 %>
  <nav aria-label="Item pages">
    <% if @current_page > 1 %>
      <%= link_to "Previous",
                  items_path(request.query_parameters.except("page").merge(page: @current_page - 1)) %>
    <% end %>

    <span>Page <%= @current_page %> of <%= @total_pages %></span>

    <% if @current_page < @total_pages %>
      <%= link_to "Next",
                  items_path(request.query_parameters.except("page").merge(page: @current_page + 1)) %>
    <% end %>

    <%= form_with url: items_path, method: :get do |form| %>
      <% request.query_parameters.except("page").each do |key, value| %>
        <%= hidden_field_tag key, value %>
      <% end %>
      <%= form.label :page, "Go to page" %>
      <%= form.number_field :page, in: 1..@total_pages, value: @current_page %>
      <%= form.submit "Go" %>
    <% end %>
  </nav>
<% end %>

<% if user_signed_in? && current_user.staff? %>
  <%= link_to "New item", new_item_path %>
<% end %>
