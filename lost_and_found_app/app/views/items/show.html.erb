<p style="color: green"><%= notice %></p>

<%= render @item %>

<div>
  <%= link_to "Edit this item", edit_item_path(@item) %> |
  <%= link_to "Back to items", items_path %>

  <%= button_to "Destroy this item", @item, method: :delete %>
</div>

<% if user_signed_in? && current_user.general? && @item.available? %>
  <%= link_to "Claim this item", new_item_claim_path(@item) %>
<% end %>