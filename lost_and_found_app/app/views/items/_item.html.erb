<div id="<%= dom_id item %>">
  <p>
    <strong>Title:</strong>
    <%= item.title %>
  </p>

  <p>
    <strong>Description:</strong>
    <%= item.description %>
  </p>

  <p>
    <strong>Category:</strong>
    <%= item.category.humanize %>
  </p>

  <p>
    <strong>Status:</strong>
    <%= item.status.humanize %>
  </p>

  <p>
    <strong>Facility:</strong>
    <%= item.facility.name %> — <%= item.facility.location %>
  </p>

  <p>
    <strong>Date found:</strong>
    <%= item.date_found&.strftime("%Y-%m-%d %H:%M") %>
  </p>
</div>