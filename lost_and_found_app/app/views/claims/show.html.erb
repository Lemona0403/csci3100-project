<%= render partial: "claim", locals: { claim: @claim, link_to_item: false } %>

<h2>Item information</h2>
<%= render @claim.item %>

<div>
  <%= link_to "Back to claims", claims_path %>

  <% if current_user.staff? && @claim.pending? %>
    <%= button_to "Approve claim", claim_path(@claim), method: :patch,
                  params: { claim: { status: "approved" } } %>
    <%= button_to "Reject claim", claim_path(@claim), method: :patch,
                  params: { claim: { status: "rejected" } } %>
  <% end %>
</div>
