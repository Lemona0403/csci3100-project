        "",
        "  # GET /items/1/edit",
        "  def edit",
        "  end",
        "",
        "  # POST /items or /items.json",
        "  def create",
        "    @item = Item.new(item_params)",
        "    @item.facility_id = current_user.facility_id",
        "    @item.status = :available",
        "",
        "    respond_to do |format|",
        "      if @item.save",
        "        format.html { redirect_to @item, notice: \"Item was successfully created.\" }",
