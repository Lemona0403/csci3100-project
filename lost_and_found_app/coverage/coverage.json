        "  before_action ->{ ensure_same_facility(@item)}, only: %i[edit update destroy]",
        "",
        "  # GET /items or /items.json",
        "  def index",
        "    if current_user.staff?",
        "      @items = Item.where(facility_id: current_user.facility_id)",
        "    else",
        "      @items = Item.available",
